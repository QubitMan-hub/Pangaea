// Cloudflare Workers (OpenNext). Free plan in development; Workers Paid at
// launch. Secrets go in `wrangler secret put`, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pangaea",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // No "images" binding: Cloudflare Images is metered and every image is
  // already resized in the browser.
  // Observability shows CPU time per request: our gauge for the free 10 ms limit.
  "observability": {
    "enabled": true,
  },
}
