# Local development: `npm run env:local` writes the Supabase values to
# .env.local. Put your own keys in .env (both are git-ignored). Next.js and
# `npm run preview` (Wrangler) read both files.
# Production: set these as Cloudflare secrets (`wrangler secret put NAME`).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Bypasses Row Level Security. Server only.
SUPABASE_SECRET_KEY=

# Optional locally: Google and GitHub OAuth apps (read by supabase/config.toml).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
