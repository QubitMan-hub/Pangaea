# Copy to .env.local (`npm run env:local` fills in the local Supabase values).
# Never commit real keys. In production, set these as Cloudflare Worker
# secrets/vars (`wrangler secret put NAME`), never in wrangler.jsonc.

# --- Supabase (free plan) ------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# --- Sign-in: Google and GitHub only (free OAuth apps) ----------------------------
# Used by supabase/config.toml locally; set in the Supabase dashboard for production.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# --- Object storage: Cloudflare R2 in production -----------------------------------
# Placeholders until the Cloudflare account exists. Locally, `npm run env:local`
# points these at Supabase Storage's S3 endpoint.
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=private
S3_PUBLIC_BUCKET=public
# Public bucket on the CDN domain, e.g. https://cdn.example.com
NEXT_PUBLIC_ASSET_BASE_URL=

# --- Moderation ---------------------------------------------------------------------
# OpenAI Moderation API (free). Use a key from a project limited to moderation.
OPENAI_API_KEY=

# --- AI (Claude: region names, borderline moderation, image checks) ---------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Hard daily budget for all Claude calls. At the cap, work waits; it is never skipped.
CLAUDE_DAILY_BUDGET_USD=1

# --- Embeddings ------------------------------------------------------------------------
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
VOYAGE_DIMENSIONS=512

# --- Background jobs (Cloudflare Cron Triggers call our routes) -------------------
CRON_SECRET=

# --- Backups (Phase 5, needs Workers Paid) -------------------------------------------
# Public key only (SPKI, base64). The private key never touches Cloudflare.
BACKUP_PUBLIC_KEY=
BACKUP_DATABASE_URL=

# --- Growth -----------------------------------------------------------------------------
EARNED_SPACE_HALF_LIFE_DAYS=30

# --- Cost guards (our limits are R2's spending cap) ---------------------------------
PLOT_MAX_MEDIA_BYTES=10485760
PLOT_MAX_IMAGES=30
PLOT_MAX_DRAWING_ELEMENTS=2000
PLOT_MAX_SCENE_BYTES=1048576
USER_MAX_UPLOADS_PER_DAY=30
