# Copy to .env.local and fill in. Never commit real keys.
# Local values for the Supabase vars come from `npx supabase status`.

# --- Supabase ---------------------------------------------------------------
# Safe for the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=

# --- AI (needed from Phase 3; optional before then) --------------------------
ANTHROPIC_API_KEY=
# Model for plot summaries and region labels. Non-urgent calls go through the
# Message Batches API (half price).
ANTHROPIC_MODEL=claude-haiku-4-5
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# --- Object storage (needed from Phase 1) ------------------------------------
# Any S3-compatible store. Production: Cloudflare R2 (free egress) with the
# public bucket on a CDN domain. Local: Supabase Storage's S3 endpoint
# (`npm run env:local` fills these in).
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRIVATE_BUCKET=private
S3_PUBLIC_BUCKET=public
# Public bucket base URL as served by the CDN.
NEXT_PUBLIC_ASSET_BASE_URL=

# --- Moderation (needed from Phase 1) ------------------------------------------
# Provider choice is still open; see docs/decisions.md. Keys will be added
# here once the text and image providers are picked.

# --- Jobs --------------------------------------------------------------------
# Shared secret that background jobs send to job endpoints (tile rebakes,
# link rechecks). There is no growth/decay job: decay is computed on read.
CRON_SECRET=

# --- Growth tuning -----------------------------------------------------------
EARNED_SPACE_HALF_LIFE_DAYS=30
